# Configuración de Conexión a Base de Datos Supabase (PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.liozqlizpovzlgmzjiic.supabase.co:5432/postgres

# Parámetros Individuales
DB_HOST=db.liozqlizpovzlgmzjiic.supabase.co
DB_PORT=5432
